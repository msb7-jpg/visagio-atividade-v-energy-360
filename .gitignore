# ==============================================================================
# V-Energy Grid 360 -- .gitignore
# ==============================================================================

# Python & Virtual Environments
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
dist/
build/
.pytest_cache/
.ruff_cache/

# Node & Frontend
node_modules/
.npm/
.bun/
frontend/dist/
frontend/node_modules/
*.tsbuildinfo

# Database & SQLite WAL
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.db-journal

# Environment & Credentials
.env
.env.local
.env.*.local
*.pem
*.key

# Data & Documents
*.zip
*.pdf
data/landing/*
!data/landing/.gitkeep
data/lakehouse/
data/gold_exports/
spark-warehouse/
metastore_db/
derby.log

# IDE & OS
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Databricks Asset Bundle (estado local do deploy)
.databricks/
