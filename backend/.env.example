# ==============================================================================
# V-Energy Grid 360 -- Backend Environment Variables (.env)
# ==============================================================================

PROJECT_NAME="V-Energy Grid 360 API"
PROJECT_VERSION="2026.2"
ENVIRONMENT="development"
API_V1_PREFIX="/api/v1"

# SQLite Assíncrono com WAL Mode
DATABASE_URL="sqlite+aiosqlite:///./v_energy.db"

# Segurança e JWT
JWT_SECRET_KEY="v-energy-grid-360-jwt-secret-key-2026-visagio-super-secure"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Provedores de IA para o Agente Text-to-SQL:
# - Nuvem Google: GEMINI_API_KEY="..." e AI_MODEL_NAME="gemini-2.5-flash-lite"
# - OpenRouter: AI_PROVIDER="openrouter", OPENROUTER_API_KEY="..." e AI_MODEL_NAME="google/gemini-2.5-flash-lite"
# - Local llama.cpp: AI_PROVIDER="local", AI_BASE_URL="http://localhost:1234/v1", AI_MODEL_NAME="Qwen3.5-4B-Q4_K_M"
# - Sem nenhum dos anteriores: a IA fica indisponível; o chat e o insight avisam e não inventam resposta
# - Demonstração offline: AI_PROVIDER="mock" (respostas fixas, marcadas como "Modo demonstração")
GEMINI_API_KEY=""
OPENROUTER_API_KEY=""
AI_PROVIDER=""
AI_BASE_URL="http://localhost:1234/v1"
AI_MODEL_NAME="gemini-2.5-flash-lite"

# Gestão de perdas (opcional): fixa a competência da fila de suspeitas para demonstração (formato YYYY-MM).
# Deixe a linha comentada em produção: a fila usa a competência mais recente dos dados.
# LOSS_REFERENCE_COMPETENCIA="2025-09"

# Nível de Logs
LOG_LEVEL="INFO"
